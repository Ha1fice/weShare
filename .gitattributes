# 默认按文本处理，检出时统一 LF
* text=auto eol=lf

# Windows 批处理脚本必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.db-wal binary
*.db-shm binary
*.zip binary
*.gz binary
