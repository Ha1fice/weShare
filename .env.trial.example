# 试用环境模板（免密模式）
#
# 用法：cp .env.trial.example .env
#       在文件顶部的"必改"三项里填你自己的值，然后 pnpm dev
#
# 差异只有一处：免密身份开关打开
#   DEVICE_IDENTITY=1         api 注册 POST /api/v1/auth/device
#   VITE_DEVICE_IDENTITY=true web 首屏变成"输个名字就进"
#
# 为什么单独一个模板而不是改 .env.example：
# 免得哪天有人把"试用配置"当成默认值抄进生产。默认值永远是关。

# ---- 必改 ----
# 允许的跨域来源。试用环境的 web 地址，逗号分隔；留空表示同源。
CORS_ORIGINS=
# WebSocket 握手 Origin 白名单。留空 = 不校验（仅内网/试用可接受）。
ALLOWED_ORIGINS=
# 会话 Cookie 是否加 Secure 与 __Host- 前缀。http 访问时保持 false；
# 一旦挂了域名和证书，必须改 true。
SECURE_COOKIE=false

# ---- 免密身份（与 .env.example 的唯一区别）----
# 注意：打开后身份安全性降到"知道 deviceKey 即可冒充"的水平。
# 仅限内网 / 试用 / 演示机，且这台机器不要放真实资料。
DEVICE_IDENTITY=true
VITE_DEVICE_IDENTITY=true

# ---- 其余沿用默认值 ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
COLLAB_PORT=3100
DB_PATH=data/weshare.db
UPLOAD_DIR=uploads
ALLOW_REGISTER=true
SESSION_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW_SECONDS=60
API_PROXY_TARGET=http://127.0.0.1:3000
COLLAB_PROXY_TARGET=ws://127.0.0.1:3100
WEB_PORT=5173
WEB_HOST=127.0.0.1
