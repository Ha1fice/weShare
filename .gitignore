# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo
.vite/

# ---- 环境变量 ----
.env
.env.*
!.env.example
!.env.trial.example

# ---- 运行期数据（不入库）----
data/            # SQLite 数据文件（weshare.db / -wal / -shm）
uploads/         # 附件
logs/
*.db
*.db-wal
*.db-shm

# ---- 工具临时目录 ----
.screenshots/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- 测试与覆盖率 ----
coverage/
*.lcov

# ---- 依赖固化包（体积大，按需生成）----
offline/
.pnpm-store/
*.tgz

# ---- 构建与工具产物 ----
*.tsbuildinfo
.eslintcache
vite.config.ts.timestamp-*

# ---- Prisma 生成的 Client（由 prisma generate 产出，不入库）----
packages/db/generated/

# ---- e2e 运行产物（playwright）----
test-results/
playwright-report/
blob-report/
e2e/artifacts/.tmp/
