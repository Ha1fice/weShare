# ---- 运行环境 ----
NODE_ENV=development

# ---- api ----
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# 允许的跨域来源，逗号分隔。生产必须显式配置。
CORS_ORIGINS=

# ---- collab ----
COLLAB_PORT=3100
# WebSocket 握手 Origin 白名单，逗号分隔。
# **留空 = 一律拒绝**（fail-closed），不是"不校验"。
# Cookie 鉴权的 WebSocket 不受同源策略保护，放行任意 Origin 等于开门揖盗
# （跨站 WebSocket 劫持 CSWSH）。开发期请填 vite 地址：
#   ALLOWED_ORIGINS=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173
# 协同落库节流（毫秒）。SQLite 单写者，每次击键都落库会把自己锁住。
STORE_DEBOUNCE_MS=1200
# 最长多久必须落一次库（毫秒）。
STORE_MAX_DEBOUNCE_MS=8000

# ---- 数据库 ----
# SQLite 文件路径。**相对于仓库根**（不是相对于进程 cwd）。
# 默认在仓库根的 data/weshare.db。
DB_PATH=data/weshare.db

# ---- 附件 ----
UPLOAD_DIR=uploads

# ---- 其他 ----
# 是否开放注册。生产应设为 false。
ALLOW_REGISTER=true
# 会话有效期（天）
SESSION_TTL_DAYS=30
# 会话 Cookie 是否加 Secure 与 __Host- 前缀。
# __Host- 前缀要求 Secure，因此本地 http 开发无法使用——开发时保持 false，
# 生产（https）必须设为 true，否则子域可以覆盖会话 Cookie。
SECURE_COOKIE=false
# 登录失败锁定：同 IP 窗口内的最大失败次数，第 N+1 次请求返回 429。
LOGIN_MAX_ATTEMPTS=5
# 登录失败锁定的窗口长度（秒）。
LOGIN_LOCK_WINDOW_SECONDS=60

# ---- 免密身份（简版形态）----
# 两边要同时打开才生效：
#   DEVICE_IDENTITY=1 让 api 注册 /api/v1/auth/device
#   VITE_DEVICE_IDENTITY=true 让 web 首屏变成"输个名字就进"
# 打开后身份安全性降到"知道 deviceKey 即可冒充"的水平，适合内网/试用；
# 生产环境请保持关闭，用邮箱密码登录。
DEVICE_IDENTITY=false
VITE_DEVICE_IDENTITY=false

# ---- web（开发期 vite 代理）----
# vite 把 /api 与 /collab 代理到这些地址。
API_PROXY_TARGET=http://127.0.0.1:3000
COLLAB_PROXY_TARGET=ws://127.0.0.1:3100
WEB_PORT=5173
WEB_HOST=127.0.0.1
