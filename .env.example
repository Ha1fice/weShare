# ---- 运行环境 ----
NODE_ENV=development

# ---- api ----
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# 允许的跨域来源，逗号分隔。生产必须显式配置。
CORS_ORIGINS=

# ---- collab ----
COLLAB_PORT=3100
# WebSocket 握手 Origin 白名单，逗号分隔。留空表示不校验（仅开发期允许）。
# 生产必须配置，否则存在跨站 WebSocket 劫持风险。
ALLOWED_ORIGINS=

# ---- 数据库 ----
# SQLite 文件路径。**相对于仓库根**（不是相对于进程 cwd）。
# 默认在仓库根的 data/weshare.db。
DB_PATH=data/weshare.db

# ---- 附件 ----
UPLOAD_DIR=uploads

# ---- 其他 ----
# 是否开放注册。生产应设为 false。
ALLOW_REGISTER=true
# 会话有效期（天）
SESSION_TTL_DAYS=30
# 会话 Cookie 是否加 Secure 与 __Host- 前缀。
# __Host- 前缀要求 Secure，因此本地 http 开发无法使用——开发时保持 false，
# 生产（https）必须设为 true，否则子域可以覆盖会话 Cookie。
SECURE_COOKIE=false
# 登录失败锁定：同 IP 窗口内的最大失败次数，第 N+1 次请求返回 429。
LOGIN_MAX_ATTEMPTS=5
# 登录失败锁定的窗口长度（秒）。
LOGIN_LOCK_WINDOW_SECONDS=60

# ---- web（开发期 vite 代理）----
# vite 把 /api 与 /collab 代理到这些地址。
API_PROXY_TARGET=http://127.0.0.1:3000
COLLAB_PROXY_TARGET=ws://127.0.0.1:3100
WEB_PORT=5173
WEB_HOST=127.0.0.1
