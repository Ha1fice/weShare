# ---- 运行环境 ----
NODE_ENV=development

# ---- api ----
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# 允许的跨域来源，逗号分隔。生产必须显式配置。
CORS_ORIGINS=

# ---- collab ----
COLLAB_PORT=3100
# WebSocket 握手 Origin 白名单，逗号分隔。留空表示不校验（仅开发期允许）。
# 生产必须配置，否则存在跨站 WebSocket 劫持风险。
ALLOWED_ORIGINS=

# ---- 数据库 ----
# SQLite 文件路径。默认在仓库根的 data/weshare.db。
DB_PATH=data/weshare.db

# ---- 附件 ----
UPLOAD_DIR=uploads

# ---- 其他 ----
# 是否开放注册。生产应设为 false。
ALLOW_REGISTER=true
# 会话有效期（天）
SESSION_TTL_DAYS=30
